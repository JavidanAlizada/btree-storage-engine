<?xml version="1.0"?>
<!DOCTYPE import-control PUBLIC
    "-//Checkstyle//DTD ImportControl Configuration 1.4//EN"
    "https://checkstyle.org/dtds/import_control_1_4.dtd">

<!--
  Layering from the design, bottom up: page formats, the page file, the buffer
  pool, the write-ahead log (with mini-transactions and recovery), the B+Tree,
  then the public API in dev.storage. A lower layer never reaches up into a
  higher one. Everything not disallowed is allowed.
-->
<import-control pkg="dev.storage" strategyOnMismatch="allowed">
    <subpackage name="page">
        <disallow pkg="dev.storage.file"/>
        <disallow pkg="dev.storage.buffer"/>
        <disallow pkg="dev.storage.wal"/>
        <disallow pkg="dev.storage.btree"/>
    </subpackage>
    <subpackage name="file">
        <disallow pkg="dev.storage.buffer"/>
        <disallow pkg="dev.storage.wal"/>
        <disallow pkg="dev.storage.btree"/>
    </subpackage>
    <subpackage name="buffer">
        <disallow pkg="dev.storage.wal"/>
        <disallow pkg="dev.storage.btree"/>
    </subpackage>
    <subpackage name="wal">
        <disallow pkg="dev.storage.btree"/>
    </subpackage>
</import-control>
