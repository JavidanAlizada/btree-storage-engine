<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
      SlottedPage is a view over a page buffer the caller owns (a buffer pool
      frame from M2 on). Handing that same buffer back is the point; copying
      it would defeat in-place page access.
    -->
    <Match>
        <Class name="dev.storage.page.SlottedPage"/>
        <Method name="buffer"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <!--
      The buffer pool works on the PageFile and Replacer it's given; they're
      collaborators shared on purpose, not internal state to copy.
    -->
    <Match>
        <Class name="dev.storage.buffer.BufferPool"/>
        <Or>
            <Field name="file"/>
            <Field name="replacer"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!--
      Tests use seeded Randoms on purpose, so a failure can be replayed from
      its seed. The detector also misfires on Randoms used inside loops.
    -->
    <Match>
        <Class name="~.*Test"/>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
    </Match>
</FindBugsFilter>
