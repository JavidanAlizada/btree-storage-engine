<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
      SlottedPage is a view over a page buffer the caller owns (a buffer pool
      frame from M2 on). Handing that same buffer back is the point; copying
      it would defeat in-place page access.
    -->
    <Match>
        <Class name="dev.storage.page.SlottedPage"/>
        <Method name="buffer"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <!--
      The buffer pool works on the PageFile and Replacer it's given; they're
      collaborators shared on purpose, not internal state to copy.
    -->
    <Match>
        <Class name="dev.storage.buffer.BufferPool"/>
        <Or>
            <Field name="file"/>
            <Field name="replacer"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!--
      Tests use seeded Randoms on purpose, so a failure can be replayed from
      its seed. The detector also misfires on Randoms used inside loops.
    -->
    <Match>
        <Class name="~.*Test"/>
        <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
    </Match>
    <!--
      Log records are internal value objects built from bytes that are copied
      already (a page image, a cloned cell, or a decoded group), and are never
      changed after that. Copying the arrays again on every access would double
      the cost of encoding and redo for nothing.
    -->
    <Match>
        <Class name="~dev\.storage\.wal\.LogRecord\$.*"/>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>
    <!--
      The store hands out its buffer pool on purpose: the B+Tree reads pages
      through it. A pool's failure cause is kept to report later, as is.
    -->
    <Match>
        <Class name="dev.storage.wal.PageStore"/>
        <Method name="pool"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="dev.storage.buffer.BufferPool"/>
        <Field name="failure"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!--
      begin() takes the store's lock shared for the mini-transaction it returns,
      and the mini-transaction releases it when it commits or closes.
    -->
    <Match>
        <Class name="dev.storage.wal.PageStore"/>
        <Method name="begin"/>
        <Bug pattern="UL_UNRELEASED_LOCK"/>
    </Match>
</FindBugsFilter>
